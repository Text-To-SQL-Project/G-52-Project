DATABASE_URL=postgresql+psycopg://app:app@db:5432/college_erp
READONLY_DATABASE_URL=postgresql+psycopg://readonly_app:readonly_app@db:5432/college_erp
DB_SCHEMA=college_erp
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=your_key_here
DEFAULT_ROW_LIMIT=1000
MAX_SUBQUERY_DEPTH=3
BACK_TRANSLATION_ENABLED=true
MULTI_QUERY_ENABLED=false
MULTI_QUERY_N=2
STATEMENT_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Minimal auth (see README.md's Auth section) -- one shared operator
# password, no users table. Required: the app refuses ALL logins (500) if
# either is empty, rather than silently accepting an empty password or
# signing tokens with a guessable key.
OPERATOR_PASSWORD=change_me
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_64_char_hex_string_do_not_use_this_placeholder
