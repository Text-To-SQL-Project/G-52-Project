# ---------------------------------------------------------------------------
# DATABASES -- read this block before copying the file.
#
# There are THREE connections and they are not interchangeable. Copying an
# example value into the wrong one does not produce an error, it produces
# wrong numbers, so each is spelled out.
#
# Host names differ by where the process runs: `db` only resolves INSIDE the
# docker-compose network. Anything you run on the host (eval/, scripts/,
# pytest) needs `localhost` and the published port.
# ---------------------------------------------------------------------------

# 1. DATABASE_URL -- owning/superuser role. Schema introspection, history
#    writes, and the eval fallback below. Inside compose this is `app`; from
#    the host use localhost and whichever port your instance listens on.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/college_erp

# 2. READONLY_DATABASE_URL -- the role GENERATED SQL executes as, and the
#    role that Row Level Security is meant to apply to from Phase 2 onward.
#
#    LEFT UNSET ON PURPOSE. docker-compose.yml already sets this for the api
#    container, and its `environment:` block wins over this file, so setting
#    it here changes nothing about the API. What it DOES change is every
#    host-side process that calls get_readonly_engine()... which used to
#    include eval/, and that was a live trap: uncommenting this line silently
#    switched eval onto the filtered role. eval/ no longer touches it at all
#    (see EVAL_DATABASE_URL below), but leave it commented unless you are
#    deliberately running the API outside Docker.
#
#    If you DO run the API on the host, you must set this. Without it
#    get_readonly_engine() falls back to DATABASE_URL, and generated SQL then
#    executes as the superuser -- no read-only enforcement, and from Phase 2,
#    no RLS either.
# READONLY_DATABASE_URL=postgresql+psycopg://readonly_app:readonly_app@localhost:5433/college_erp

# 3. EVAL_DATABASE_URL -- eval/ only. Must see EVERY row: eval compares gold
#    against predicted row sets, so a filtered connection does not fail, it
#    just reports different numbers and the published baselines stop being
#    reproducible. The role must be a superuser, hold BYPASSRLS, or own every
#    table in the schema without FORCE ROW LEVEL SECURITY.
#
#    eval/db_guard.py checks the live connection at startup and aborts the
#    run if it would be filtered, so a mistake here is a crash, not a drift.
#    Leave unset to fall back to DATABASE_URL (never to READONLY_DATABASE_URL).
#
#    NOTE: eval and the API deliberately run against two different PostgreSQL
#    instances. See eval/README.md, "Which database eval runs against".
# EVAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college_erp

DB_SCHEMA=college_erp
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=your_key_here
# Max tokens the model may generate per call (passed as max_tokens on every
# provider path). 1024 is the code default and is ample for this project's
# JSON response shape -- raise it only if generated SQL is being truncated.
MAX_OUTPUT_TOKENS=1024
# Per-request timeout (seconds) for BOTH the Anthropic and the
# OpenAI-compatible (Gemini/Groq) client -- without this, a hung upstream
# response blocks a request thread indefinitely instead of failing into
# the normal ERROR response. 60 is a reasonable default; lower it for
# faster fail-fast behavior in an eval run.
LLM_TIMEOUT_SECONDS=60
# 0 = unlimited. For Groq, 6 -- NOT its nominal 30 RPM cap: at this
# project's ~2,011-token generate_sql prompt, Groq's 6,000 TPM cap binds
# first (30 RPM would blow the token budget well before the request
# budget). 6 is the largest RPM value that provably stays under 6,000 TPM
# every 60s window, given the pipeline's fixed big/small/small call cycle
# -- see eval/README.md's Groq-fallback note for the derivation. For
# Gemini, RPM isn't the real constraint -- check your per-model DAILY
# quota in AI Studio (https://aistudio.google.com/rate-limit) first.
LLM_RPM_LIMIT=0
# 0 = unlimited. A hard ceiling on real LLM calls for ONE eval.runner
# invocation -- guards against a DAILY provider quota (separate from
# RPM/TPM) getting exhausted mid-run with nothing stopping the runner
# from continuing to attempt (and retry, 5x each) every remaining
# question regardless -- observed live: 2,128 pointless 429s once this
# happened with no ceiling set. Set below the provider's actual daily
# cap, with margin. Consumed by eval/runner.py only, never the live API
# -- see eval/README.md's Provider throughput section.
LLM_DAILY_CALL_LIMIT=0
DEFAULT_ROW_LIMIT=1000
MAX_SUBQUERY_DEPTH=3
BACK_TRANSLATION_ENABLED=true
MULTI_QUERY_ENABLED=false
MULTI_QUERY_N=2
# Applied per query on the read-only (student/faculty) path.
STATEMENT_TIMEOUT_MS=2500
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# INTERACTIVE LATENCY (/v1/query only -- eval/ ignores these)
# ---------------------------------------------------------------------------
# Per-call LLM timeout and attempts for SQL generation in the app.
APP_LLM_TIMEOUT_SECONDS=10
APP_LLM_MAX_ATTEMPTS=2
# Send a duplicate generation request if the first hasn't answered in this
# many seconds; first answer wins. Ignored while LLM_RPM_LIMIT > 0 (it would
# only burn quota). 0 disables.
APP_LLM_HEDGE_SECONDS=2.5
# Schema structure cache (served stale while refreshing in the background).
SCHEMA_CACHE_SECONDS=300

# ---------------------------------------------------------------------------
# PRODUCTION
# ---------------------------------------------------------------------------
# prod: refuse to boot with a <32 char SECRET_KEY or CORS '*', send HSTS,
# and drop the any-localhost-port CORS rule.
ENV=dev
# Sliding 60 s windows. Login is per client IP, queries are per user.
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_QUERY_PER_MIN=30

# ---------------------------------------------------------------------------
# AI KEY POOL (LiteLLM proxy; `docker compose up -d litellm`)
# ---------------------------------------------------------------------------
# Admins add provider keys in the Admin screen; the proxy stores them
# encrypted and routes each request to the fastest healthy one.
LITELLM_URL=http://localhost:4000
# Must start with sk-. Generate: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=
# Encrypts stored provider keys. Generate the same way; NEVER change it later.
LITELLM_SALT_KEY=
# auto = use the pool for app queries whenever it has a key, else LLM_PROVIDER.
APP_LLM_PROVIDER=auto

# ---------------------------------------------------------------------------
# AUTH (Phase 1: per-user accounts in app.users, Argon2id hashing)
# ---------------------------------------------------------------------------

# Bootstrap admin password. No longer a shared login for everyone -- it
# seeds the FIRST admin account so there is a way in before any user
# exists. Consumed by scripts/seed_users.py, which also accepts
# SEED_ADMIN_PASSWORD in preference to it.
OPERATOR_PASSWORD=change_me

# Seed account passwords for scripts/seed_users.py. No defaults anywhere in
# the code: a demo account with a committed password is a real account with
# a public password.
# SEED_ADMIN_PASSWORD=
# SEED_STUDENT_PASSWORD=
# SEED_FACULTY_PASSWORD=

# How long a resolved user may be reused before role and is_active are
# re-read from the database.
#
# 0 = never cache, re-read on every request. This is the default and the
# recommended setting. The token carries only a user id; role and active
# status are deliberately NOT claims, because a claim is frozen at issue
# time and these gate authorisation -- and from Phase 2, row visibility.
#
# WHATEVER YOU SET HERE IS YOUR REVOCATION LATENCY. A deactivated user keeps
# working for up to this many seconds. It is a security parameter, not a
# performance knob; the lookup it avoids is a single indexed primary-key
# SELECT (measured ~5ms) against a multi-second LLM call on the only hot
# path.
AUTH_PRINCIPAL_CACHE_SECONDS=0
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_64_char_hex_string_do_not_use_this_placeholder
